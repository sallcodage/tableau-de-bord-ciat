# Copier ce fichier en .env puis compléter
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Clé gratuite : https://aistudio.google.com/apikey  (sans clé, l'assistant fonctionne avec un analyseur à règles)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AI_RATE_LIMIT_PER_HOUR=40

# Mot de passe des comptes de démonstration (seed_demo)
DEMO_PASSWORD=Ciat2026!demo

# En production (Render) : URL PostgreSQL fournie automatiquement
# DATABASE_URL=postgres://...
